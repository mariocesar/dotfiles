"""

JS = r"""
"use strict";

const $ = (s) => document.querySelector(s);
const el = (tag, cls, text) => {
  const e = document.createElement(tag);
  if (cls) e.className = cls;
  if (text != null) e.textContent = text;
  return e;
};

const ROOT = document.body.dataset.root;
const narrow = matchMedia("(max-width: 760px)");
const MAX_HITS = 200;

const S = {
  dir: null, entries: [], cur: 0, hidden: 0, error: null,   // listing
  focus: "list",                                           // or "tree"
  pv: false, file: null, pushed: false,                    // preview
  tree: { open: new Set([""]), kids: new Map(), rows: [], cur: 0 },
  index: null, indexTruncated: false, found: [], fcur: 0,  // jump to file
};

const BAD = {
  broken: "broken symlink",
  outside: "symlink leaves the served directory",
  hidden: "symlink to a protected file",
};
const SUFFIX = { dir: "/", up: "/", link: "@", fifo: "|", socket: "=" };
const MEDIA = { image: "img", audio: "audio", video: "video", pdf: "iframe" };
const HINTS = {
  list: "j/k move  l open  h up  t find  ? keys",
  tree: "j/k move  l open  h close  tab list",
};


// ── helpers ────────────────────────────────────────────────────────────────

const join = (a, b) => (a ? a + "/" + b : b);
const parent = (p) => p.slice(0, Math.max(0, p.lastIndexOf("/")));
const base = (p) => p.slice(p.lastIndexOf("/") + 1);
const enc = (p) => p.split("/").map(encodeURIComponent).join("/");
const hashFor = (dir, file) =>
  "#/" + (dir ? enc(dir) + "/" : "") + (file ? encodeURIComponent(file) : "");
const rawUrl = (path, dl) => "/raw?" + new URLSearchParams(dl ? { path, dl: 1 } : { path });
const dirNames = (entries) => entries.filter((e) => e.kind === "dir").map((e) => e.name);

const isDir = (e) =>
  e.kind === "dir" || e.kind === "up" || (e.kind === "link" && e.link === "dir");
const readable = (e) =>
  (e.kind === "file" && !e.noread) || (e.kind === "link" && e.link === "file");
const suffix = (e) =>
  e.kind === "file" ? (/x/.test(e.mode) ? "*" : "") : SUFFIX[e.kind] || "";

function linkText(e) {
  if (e.link === "outside") return " → outside root";
  if (e.link === "hidden") return " → protected";
  return " → " + e.target + (e.link === "broken" ? " (broken)" : "");
}

async function api(url, params) {
  const r = await fetch(url + "?" + new URLSearchParams(params));
  const body = await r.json().catch(() => ({}));
  if (!r.ok) throw new Error(body.error || `${r.status} ${r.statusText}`);
  return body;
}

function fmtSize(n) {
  if (n < 1024) return n + "B";
  let i = -1;
  do { n /= 1024; i++; } while (n >= 1024 && i < 5);
  return (n < 10 ? n.toFixed(1) : Math.round(n)) + "KMGTPE"[i];
}

const pad = (n) => String(n).padStart(2, "0");
function fmtTime(t) {
  const d = new Date(t * 1000);
  return [
    `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`,
    `${pad(d.getHours())}:${pad(d.getMinutes())}`,
  ];
}
const stamp = (t) => fmtTime(t).join(" ");
const metaLine = (...parts) => parts.filter(Boolean).join("  ·  ");


// ── routing ────────────────────────────────────────────────────────────────

// #/dir/ lists a directory, #/dir/file also previews a file

function parseHash() {
  const segs = (location.hash.slice(1) || "/").split("/").slice(1);
  const last = segs.pop() || "";
  try {
    return {
      dir: segs.filter(Boolean).map(decodeURIComponent).join("/"),
      file: last ? decodeURIComponent(last) : null,
    };
  } catch {
    return { dir: "", file: null };
  }
}

const go = (dir) => { location.hash = hashFor(dir); };

async function route() {
  const { dir, file } = parseHash();
  if (dir !== S.dir && !(await loadDir(dir))) return;
  if (!file) return closePreview();

  const i = S.entries.findIndex((e) => e.name === file);
  if (i < 0) return closePreview();
  setCursor(i, true);
  if (!S.pv || S.file !== file) openPreview(S.entries[i]);
}

let dirSeq = 0;
async function loadDir(dir) {
  const seq = ++dirSeq;
  let res;
  let error = null;
  try {
    res = await api("/api/ls", { path: dir });
  } catch (err) {
    error = err.message;
    res = { path: dir, entries: [], hidden: 0 };
  }
  if (seq !== dirSeq) return false;

  const prev = S.dir;
  Object.assign(S, { dir: res.path, hidden: res.hidden, error, pushed: false, cur: 0 });
  if (res.path !== dir) history.replaceState(null, "", hashFor(res.path, parseHash().file));
  S.entries = res.path ? [{ name: "..", kind: "up" }, ...res.entries] : res.entries;
  if (!error) S.tree.kids.set(res.path, dirNames(res.entries));

  // back up from a child directory: land on it
  let cur = 0;
  const fromChild = prev !== null && prev !== res.path
    && (res.path === "" || prev.startsWith(res.path + "/"));
  if (fromChild) {
    const child = prev.slice(res.path ? res.path.length + 1 : 0).split("/")[0];
    cur = Math.max(0, S.entries.findIndex((e) => e.name === child));
  }

  renderList();
  setCursor(cur, true);
  revealInTree(res.path);
  return true;
}


// ── list ───────────────────────────────────────────────────────────────────

function rowClass(e) {
  let c = "row k-" + e.kind;
  if (suffix(e) === "*") c += " exec";
  if (BAD[e.link]) c += " bad";
  if (e.noread) c += " noread";
  return c;
}

function renderList() {
  const frag = document.createDocumentFragment();
  S.entries.forEach((e, i) => {
    const name = el("span", "name");
    name.append(el("span", "n", e.name), el("span", "cls", suffix(e)));
    if (e.kind === "link") name.append(el("span", "tgt", linkText(e)));

    const time = el("span", "time");
    if (e.mtime) {
      const [date, hm] = fmtTime(e.mtime);
      time.append(date, el("span", "hm", " " + hm));
    }

    const size = e.kind === "up" || BAD[e.link] ? "" : isDir(e) ? "-" : fmtSize(e.size);
    const row = el("div", rowClass(e));
    row.dataset.i = i;
    row.append(name, el("span", "mode", e.mode || ""), el("span", "size", size), time);
    frag.append(row);
  });

  if (S.error) frag.append(el("div", "note err", S.error));
  else if (!S.entries.some((e) => e.kind !== "up")) frag.append(el("div", "note", "empty"));
  $("#rows").replaceChildren(frag);
  renderCrumbs();
  status();
}

function setCursor(i, quiet) {
  if (!S.entries.length) return status();
  const rows = $("#rows").children;
  i = Math.max(0, Math.min(S.entries.length - 1, i));
  rows[S.cur]?.classList.remove("cur");
  S.cur = i;
  rows[i].classList.add("cur");
  rows[i].scrollIntoView({ block: "nearest" });
  status();
  if (S.pv && !quiet) follow();
}

// an open preview tracks the cursor
let followTimer;
function follow() {
  clearTimeout(followTimer);
  followTimer = setTimeout(() => {
    const e = S.entries[S.cur];
    if (!e || !S.pv || e.name === S.file) return;
    if (!isDir(e)) history.replaceState(null, "", hashFor(S.dir, e.name));
    openPreview(e);
  }, 90);
}

function activate(e) {
  if (!e) return;
  if (e.kind === "up") return go(parent(S.dir));
  if (e.kind === "dir") return go(join(S.dir, e.name));
  if (e.kind === "link" && e.link === "dir") return go(e.real);
  openFile(e);
}

function openFile(e) {
  const h = hashFor(S.dir, e.name);
  if (location.hash === h) return openPreview(e);
  S.pushed = !S.pv;  // closing can then step back instead of stacking history
  location.hash = h;
}

function renderCrumbs() {
  const link = (label, path) => {
    const a = el("a", null, label);
    a.href = hashFor(path);
    return a;
  };
  const parts = S.dir ? S.dir.split("/") : [];
  const nav = $("#crumbs");
  nav.replaceChildren(link(ROOT, ""));
  parts.forEach((p, i) => {
    nav.append(el("span", "sep", "/"), link(p, parts.slice(0, i + 1).join("/")));
  });
  nav.scrollLeft = nav.scrollWidth;
  document.title = (parts.at(-1) || ROOT) + " — share";
}

function status() {
  const n = S.entries.filter((e) => e.kind !== "up").length;
  const items = `${n} ${n === 1 ? "item" : "items"}` + (S.hidden ? `, ${S.hidden} hidden` : "");
  const info = $("#st-info");
  info.className = S.error ? "err" : "";
  info.textContent = S.error || `/${S.dir ?? ""}  ${items}`;
  $("#st-mode").textContent = $("#finder").hidden ? S.focus : "find";
  $("#st-hint").textContent = HINTS[S.focus];
}


// ── preview ────────────────────────────────────────────────────────────────

let pvSeq = 0;

function message(glyph, title, sub) {
  const m = el("div", "msg");
  m.append(el("div", "g", glyph), el("div", "t", title));
  if (sub) m.append(el("div", null, sub));
  $("#pv-body").replaceChildren(m);
}

async function openPreview(e) {
  const seq = ++pvSeq;
  const path = join(S.dir, e.name);
  const target = e.kind === "link" ? linkText(e).trim() : "";
  S.pv = true;
  S.file = e.name;
  document.body.classList.add("pv");
  $("#preview").hidden = false;
  $("#pv-name").textContent = e.name + suffix(e);
  $("#pv-meta").textContent = metaLine(e.mode, e.mtime && stamp(e.mtime), target);
  $("#pv-open").hidden = $("#pv-dl").hidden = true;

  if (isDir(e)) return message("▣", "directory", "l or ⏎ opens it");
  if (BAD[e.link]) return message("⊘", BAD[e.link], "blocked, nothing to show");
  if (e.noread) return message("⊘", "permission denied");
  if (!readable(e)) {
    const what = e.kind === "link" ? "symlink to a special file" : `${e.kind} · special file`;
    return message("◇", what, "never opened");
  }

  $("#pv-body").replaceChildren(el("div", "note", "loading…"));
  let f;
  try {
    f = await api("/api/file", { path });
  } catch (err) {
    if (seq === pvSeq) message("✕", err.message);
    return;
  }
  if (seq !== pvSeq) return;

  $("#pv-meta").textContent = metaLine(fmtSize(f.size), f.mime, f.mode, stamp(f.mtime), target);
  $("#pv-dl").href = rawUrl(path, true);
  $("#pv-dl").hidden = false;

  if (f.kind in MEDIA) {
    $("#pv-open").href = rawUrl(path);
    $("#pv-open").hidden = false;
    showMedia(MEDIA[f.kind], rawUrl(path), f.name);
  }
  else if (f.kind === "text") showText(f);
  else if (f.kind === "empty") message("∅", "empty file");
  else message("▦", "binary file", "no preview, download it to open");
}

function showMedia(tag, src, name) {
  const m = el(tag);
  m.src = src;
  if (tag === "img") m.alt = name;
  if (tag === "iframe") m.title = name;
  if (tag === "audio" || tag === "video") {
    Object.assign(m, { controls: true, preload: "metadata", playsInline: true });
  }
  const box = el("div", "media");
  box.append(m);
  $("#pv-body").replaceChildren(box);
}

function showText(f) {
  const lines = f.text.replace(/\r\n?/g, "\n").split("\n");
  if (lines.length > 1 && lines.at(-1) === "") lines.pop();

  const code = el("div", "code");
  code.append(
    el("pre", "gutter", lines.map((_, i) => i + 1).join("\n")),
    el("pre", "text", lines.join("\n")),
  );

  const body = $("#pv-body");
  body.replaceChildren();
  if (f.truncated) {
    const note = `showing the first ${fmtSize(f.text.length)} of ${fmtSize(f.size)}`;
    body.append(el("div", "trunc", note));
  }
  body.append(code);
  body.scrollTo(0, 0);
}

function closePreview() {
  if (!S.pv) return;
  S.pv = false;
  S.file = null;
  pvSeq++;
  document.body.classList.remove("pv");
  $("#preview").hidden = true;
  $("#pv-body").replaceChildren();  // stops playing media
}

function dismissPreview() {
  if (!S.pv) return;
  const h = hashFor(S.dir);
  if (S.pushed) {
    S.pushed = false;
    history.back();
  }
  else if ((location.hash || "#/") === h) closePreview();
  else location.hash = h;
}

function togglePreview(e) {
  if (S.pv) dismissPreview();
  else if (e && isDir(e)) openPreview(e);
  else if (e) openFile(e);
}


// ── tree ───────────────────────────────────────────────────────────────────

async function fetchKids(path) {
  try {
    S.tree.kids.set(path, dirNames((await api("/api/ls", { path })).entries));
  } catch {
    S.tree.kids.set(path, []);
  }
}

function renderTree() {
  const t = S.tree;
  const rows = [];
  const walk = (path, depth) => {
    rows.push({ path, depth });
    if (t.open.has(path)) for (const n of t.kids.get(path) || []) walk(join(path, n), depth + 1);
  };
  walk("", 0);
  t.rows = rows;
  t.cur = Math.min(t.cur, rows.length - 1);

  const frag = document.createDocumentFragment();
  rows.forEach((r, i) => {
    const kids = t.kids.get(r.path);
    const twisty = kids && !kids.length ? "·" : kids && t.open.has(r.path) ? "▾" : "▸";
    const row = el("div", "trow" + (r.path === S.dir ? " here" : "") + (i === t.cur ? " cur" : ""));
    row.dataset.i = i;
    row.style.setProperty("--depth", r.depth);
    row.append(el("span", "tw", twisty), el("span", "tn", (r.path ? base(r.path) : ROOT) + "/"));
    frag.append(row);
  });
  $("#tree-rows").replaceChildren(frag);
}

function setTreeCursor(i) {
  const t = S.tree;
  const rows = $("#tree-rows").children;
  if (!rows.length) return;
  i = Math.max(0, Math.min(t.rows.length - 1, i));
  rows[t.cur]?.classList.remove("cur");
  t.cur = i;
  rows[i].classList.add("cur");
  rows[i].scrollIntoView({ block: "nearest" });
}

async function toggleTree(path, open = !S.tree.open.has(path)) {
  if (open) {
    if (!S.tree.kids.has(path)) await fetchKids(path);
    S.tree.open.add(path);
  }
  else S.tree.open.delete(path);
  renderTree();
}

async function revealInTree(dir) {
  const parts = dir ? dir.split("/") : [];
  for (let i = 0; i < parts.length; i++) {
    const p = parts.slice(0, i).join("/");
    if (!S.tree.kids.has(p)) await fetchKids(p);
    S.tree.open.add(p);
  }
  S.tree.open.add(dir);
  if (dir !== S.dir) return;
  renderTree();
  setTreeCursor(S.tree.rows.findIndex((r) => r.path === dir));
}

const treeShown = () => document.body.classList.contains("tree");

function setTree(on) {
  document.body.classList.toggle("tree", on);
  if (!on && S.focus === "tree") setFocus("list");
}

function setFocus(f) {
  S.focus = f;
  $("#tree").classList.toggle("focus", f === "tree");
  $("#list").classList.toggle("focus", f === "list");
  status();
}


// ── jump to file ───────────────────────────────────────────────────────────

// fuzzy on the file name; on the whole path once the query has a slash

async function loadIndex() {
  try {
    const r = await api("/api/index", {});
    S.indexTruncated = r.truncated;
    S.index = r.files.map((p) => {
      const cut = p.lastIndexOf("/") + 1;
      return { p, n: p.slice(cut), lp: p.toLowerCase(), ln: p.slice(cut).toLowerCase(), cut };
    });
  } catch {
    S.index = [];
  }
  if (!$("#finder").hidden) runFinder();
}

// subsequence match in its tightest window, scored for runs, word starts and camelCase humps
function fuzzy(q, s, orig) {
  let qi = 0;
  let end = -1;
  for (let i = 0; i < s.length; i++) {
    if (s[i] === q[qi] && ++qi === q.length) { end = i; break; }
  }
  if (end < 0) return null;

  let start = end;
  qi = q.length - 1;
  for (let i = end; i >= 0; i--) {
    if (s[i] === q[qi] && --qi < 0) { start = i; break; }
  }

  const pos = [];
  let score = 0;
  let prev = -2;
  qi = 0;
  for (let i = start; i <= end && qi < q.length; i++) {
    if (s[i] !== q[qi]) continue;
    const before = orig[i - 1];
    let bonus = 1;
    if (i === prev + 1) bonus += 4;
    if (i === 0 || "/_-. ".includes(before)) bonus += 6;
    else if (orig[i] !== s[i] && before === before.toLowerCase()) bonus += 4;
    score += bonus;
    pos.push(i);
    prev = i;
    qi++;
  }
  return { score: score - (end - start + 1 - q.length) * 0.5 - s.length * 0.02, pos };
}

function runFinder() {
  const box = $("#fres");
  const foot = $("#ffoot");
  if (!S.index) {
    box.replaceChildren(el("div", "note", "loading index…"));
    foot.textContent = "";
    return;
  }

  const q = $("#fq").value.toLowerCase().replace(/\s+/g, "");
  const byPath = q.includes("/");
  let found = [];
  if (!q) {
    found = S.index.slice(0, MAX_HITS).map((f) => ({ f, pos: [], off: 0 }));
  } else {
    for (const f of S.index) {
      const m = byPath ? fuzzy(q, f.lp, f.p) : fuzzy(q, f.ln, f.n);
      if (m) found.push({ f, pos: m.pos, off: byPath ? 0 : f.cut, score: m.score });
    }
    found.sort((a, b) => b.score - a.score || a.f.p.length - b.f.p.length);
  }

  const total = q ? found.length : S.index.length;
  S.found = found.slice(0, MAX_HITS);
  S.fcur = 0;

  const frag = document.createDocumentFragment();
  S.found.forEach((r, i) => frag.append(hitRow(r, i)));
  if (!S.found.length) frag.append(el("div", "note", "no match"));
  box.replaceChildren(frag);
  box.scrollTop = 0;

  const limit = S.indexTruncated ? " (index limit reached)" : "";
  foot.textContent = `${total} / ${S.index.length} files${limit}   ↑↓ move  ⏎ open  esc close`;
}

function hitRow(r, i) {
  const row = el("div", "fr" + (i === S.fcur ? " cur" : ""));
  row.dataset.i = i;
  const p = r.f.p;
  const marks = new Set(r.pos.map((x) => x + r.off));
  let run = "";
  let cls = null;
  const flush = () => { if (run) row.append(el("span", cls, run)); run = ""; };
  for (let j = 0; j < p.length; j++) {
    const c = (j < r.f.cut ? "d" : "b") + (marks.has(j) ? " hit" : "");
    if (c !== cls) { flush(); cls = c; }
    run += p[j];
  }
  flush();
  return row;
}

function moveFound(delta) {
  const rows = $("#fres").children;
  if (!S.found.length) return;
  rows[S.fcur].classList.remove("cur");
  S.fcur = (S.fcur + delta + S.found.length) % S.found.length;
  rows[S.fcur].classList.add("cur");
  rows[S.fcur].scrollIntoView({ block: "nearest" });
}

function pickFound(i) {
  const r = S.found[i];
  if (!r) return;
  closeFinder();
  S.pushed = !S.pv;
  location.hash = hashFor(r.f.p.slice(0, Math.max(0, r.f.cut - 1)), r.f.n);
}

function openFinder() {
  $("#finder").hidden = false;
  $("#fq").value = "";
  $("#fq").focus();
  runFinder();
  status();
}

function closeFinder() {
  $("#finder").hidden = true;
  $("#fq").blur();
  status();
}

const toggleHelp = (on) => { $("#help").hidden = !on; };


// ── keys ───────────────────────────────────────────────────────────────────

function globalKey(k) {
  switch (k) {
    case "t": openFinder(); break;
    case "?": toggleHelp(true); break;
    case "b": setTree(!treeShown()); break;
    case "~": go(""); break;
    case "Tab": setFocus(S.focus === "list" && treeShown() ? "tree" : "list"); break;
    case "Escape":
      if (narrow.matches && treeShown()) setTree(false);
      else dismissPreview();
      break;
    case "J": case "K": {
      const body = $("#pv-body");
      body.scrollBy({ top: (k === "J" ? 0.4 : -0.4) * body.clientHeight });
      break;
    }
    default: return false;
  }
  return true;
}

function listKey(k) {
  const e = S.entries[S.cur];
  switch (k) {
    case "j": case "ArrowDown": setCursor(S.cur + 1); break;
    case "k": case "ArrowUp": setCursor(S.cur - 1); break;
    case "g": case "Home": setCursor(0); break;
    case "G": case "End": setCursor(S.entries.length - 1); break;
    case "l": case "ArrowRight": case "Enter": activate(e); break;
    case "h": case "ArrowLeft": case "Backspace": case "-": if (S.dir) go(parent(S.dir)); break;
    case " ": togglePreview(e); break;
    case "d": if (e && readable(e)) location.href = rawUrl(join(S.dir, e.name), true); break;
    default: return false;
  }
  return true;
}

function treeKey(k) {
  const t = S.tree;
  const r = t.rows[t.cur];
  switch (k) {
    case "j": case "ArrowDown": setTreeCursor(t.cur + 1); break;
    case "k": case "ArrowUp": setTreeCursor(t.cur - 1); break;
    case "g": case "Home": setTreeCursor(0); break;
    case "G": case "End": setTreeCursor(t.rows.length - 1); break;
    case "l": case "ArrowRight": toggleTree(r.path, true); go(r.path); break;
    case "Enter": go(r.path); break;
    case "h": case "ArrowLeft":
      if (r.path && t.open.has(r.path) && t.kids.get(r.path)?.length) toggleTree(r.path, false);
      else setTreeCursor(t.rows.findIndex((x) => x.path === parent(r.path)));
      break;
    default: return false;
  }
  return true;
}

document.addEventListener("keydown", (ev) => {
  if (ev.ctrlKey || ev.metaKey || ev.altKey) return;
  if (ev.target.matches("input") || !$("#finder").hidden) return;  // the finder has its own keys

  if (!$("#help").hidden) {
    toggleHelp(false);  // any key closes the help
    ev.preventDefault();
    return;
  }
  const handled = globalKey(ev.key) || (S.focus === "tree" ? treeKey(ev.key) : listKey(ev.key));
  if (handled) ev.preventDefault();
});

$("#fq").addEventListener("keydown", (ev) => {
  const k = ev.key;
  const ctrl = ev.ctrlKey;
  if (k === "Escape") closeFinder();
  else if (k === "Enter") pickFound(S.fcur);
  else if (k === "ArrowDown" || (ctrl && (k === "n" || k === "j"))) moveFound(1);
  else if (k === "ArrowUp" || (ctrl && (k === "p" || k === "k"))) moveFound(-1);
  else return;
  ev.preventDefault();
});
$("#fq").addEventListener("input", runFinder);


// ── pointer ────────────────────────────────────────────────────────────────

$("#rows").addEventListener("click", (ev) => {
  if (narrow.matches && treeShown()) return setTree(false);  // a tap beside the drawer closes it
  const row = ev.target.closest(".row");
  if (!row) return;
  setFocus("list");
  setCursor(+row.dataset.i, true);
  activate(S.entries[S.cur]);
});

$("#tree-rows").addEventListener("click", (ev) => {
  const row = ev.target.closest(".trow");
  if (!row) return;
  const r = S.tree.rows[+row.dataset.i];
  setFocus("tree");
  setTreeCursor(+row.dataset.i);
  if (ev.target.classList.contains("tw")) return toggleTree(r.path);
  go(r.path);
  if (narrow.matches) setTree(false);
});

$("#finder").addEventListener("click", (ev) => {
  if (ev.target.id === "finder") return closeFinder();
  const row = ev.target.closest(".fr");
  if (row) pickFound(+row.dataset.i);
});

$("#help").addEventListener("click", (ev) => { if (ev.target.id === "help") toggleHelp(false); });
$("#pv-close").addEventListener("click", dismissPreview);
$("#tree-btn").addEventListener("click", () => setTree(!treeShown()));
$("#find-btn").addEventListener("click", openFinder);
$("#help-btn").addEventListener("click", () => toggleHelp(true));


// ── start ──────────────────────────────────────────────────────────────────

window.addEventListener("hashchange", route);
setTree(!narrow.matches);
setFocus("list");
route();
loadIndex();
