      <dt>space</dt>    <dd>toggle preview</dd>
      <dt>J K</dt>      <dd>scroll preview</dd>
      <dt>d</dt>        <dd>download</dd>
      <dt>t</dt>        <dd>jump to file</dd>
      <dt>tab</dt>      <dd>switch tree / list</dd>
      <dt>b</dt>        <dd>show / hide tree</dd>
      <dt>~</dt>        <dd>root</dd>
      <dt>esc</dt>      <dd>close</dd>
    </dl>
  </div>
