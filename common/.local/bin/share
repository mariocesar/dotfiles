"""

# Azulejo Brutalism palette, github.com/VerticalHeretic/AzulejoBrutalism
CSS = r"""
:root {
  color-scheme: light dark;
  --bg: #F3F0E8; --bg-alt: #E8E4D9; --sel: #DDE2EF; --line: #D8D4C8;
  --fg: #0C1030; --fg-dim: #3D4163; --muted: #5A5E78; --faint: #8A8DA3;
  --primary: #1E2A9E; --ochre: #D49A1A;
  --red: #B03A2E; --green: #2F6B3A; --purple: #6B2E80; --teal: #1D6E7E;
  --mono: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, "Cascadia Mono", monospace;
}

@media (prefers-color-scheme: dark) {
  :root {
