#!/usr/bin/env -S uv run --quiet --script
# Share a directory read-only as a web file browser, a safer `python -m http.server`.
# /// script
# requires-python = ">=3.12"
# dependencies = ["starlette>=1.0", "uvicorn>=0.34", "pathspec>=0.12"]
# ///
# vim: set filetype=python :

import re
import argparse
import codecs
import contextlib
import gzip
import html
import ipaddress
import json
import logging
import mimetypes
import os
from pathlib import Path
import socket
import stat
import time
from urllib.parse import quote, urlsplit

import pathspec
from starlette.applications import Starlette
from starlette.exceptions import HTTPException
from starlette.responses import HTMLResponse, PlainTextResponse, Response, StreamingResponse
from starlette.routing import Route
import uvicorn


# ── what stays hidden ───────────────────────────────────────────────────────

# Never listed or served, not even with --no-ignore.
SECRETS = """
    .git .hg .svn
    .env* .netrc .pgpass .git-credentials .npmrc .pypirc
    .ssh .gnupg .aws .azure .kube .docker .password-store
    id_rsa* id_dsa* id_ecdsa* id_ed25519* *.pem *.key *.p12 *.pfx *.kdbx
"""

# Hidden like .gitignored files; --no-ignore shows them.
NOISE = ".venv __pycache__ node_modules .*_cache .tox .nox .DS_Store"

SECRET_SPEC = pathspec.GitIgnoreSpec.from_lines(SECRETS.split())
NOISE_SPEC = pathspec.GitIgnoreSpec.from_lines(NOISE.split())


# ── ignore rules ────────────────────────────────────────────────────────────

SPEC_RECHECK = 2.0  # seconds
spec_cache = {}  # path: (checked at, mtime_ns, spec)


def read_spec(path):
    now = time.monotonic()
    cached = spec_cache.get(path)
    if cached and now - cached[0] < SPEC_RECHECK:
        return cached[2]

    try:
        st = path.stat()
    except OSError:
        st = None
    mtime = st.st_mtime_ns if st else None
    spec = cached[2] if cached and cached[1] == mtime else None

    # a fifo named .gitignore would block open()
    if spec is None and st and stat.S_ISREG(st.st_mode):
        with contextlib.suppress(OSError, ValueError), path.open("rb") as f:
            lines = f.read(1 << 20).decode("utf-8", "replace").splitlines()
            spec = pathspec.GitIgnoreSpec.from_lines(lines)

    spec_cache[path] = (now, mtime, spec)
    return spec


def ignored(parts, *, is_dir):
    """Judges only the last part; hidden() walks the whole path."""
    name = parts[-1]
    if SECRET_SPEC.match_file(name):
        return True
    if not GITIGNORE:
        return False
    if NOISE_SPEC.match_file(name):
        return True

    tail = "/" if is_dir else ""
    for i in range(len(parts) - 1, -1, -1):  # deepest .gitignore decides first, like git
        spec = read_spec(ROOT.joinpath(*parts[:i], ".gitignore"))
        if spec and (hit := spec.check_file("/".join(parts[i:]) + tail).include) is not None:
            return hit

    for prefix, source in EXCLUDES:
        spec = read_spec(source)
        if spec and (hit := spec.check_file(prefix + "/".join(parts) + tail).include) is not None:
            return hit

    return False


def hidden(parts):
    last = len(parts)
    return any(
        ignored(parts[:i], is_dir=i < last or ROOT.joinpath(*parts).is_dir())
        for i in range(1, last + 1)
    )


# ── paths ───────────────────────────────────────────────────────────────────


def under_root(path):
    real = Path(os.path.realpath(path))
    return list(real.relative_to(ROOT).parts) if real.is_relative_to(ROOT) else None


def resolve(rel):
    parts = [p for p in rel.split("/") if p not in ("", ".")]
    if ".." in parts or any("\0" in p for p in parts) or hidden(parts):
        raise HTTPException(404, "not found")

    real = under_root(ROOT.joinpath(*parts))
    if real is None or (real != parts and hidden(real)):
        raise HTTPException(404, "not found")
    return real


def open_real(parts, *, directory=False):
    """O_NOFOLLOW on every part, so a path swapped for a symlink after resolve() can't escape."""
    fd = os.open(ROOT, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        for i, name in enumerate(parts):
            flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC
            if directory or i < len(parts) - 1:
                flags |= os.O_DIRECTORY
            else:  # opening a fifo or device can block or have side effects
                if not stat.S_ISREG(os.stat(name, dir_fd=fd, follow_symlinks=False).st_mode):
                    raise HTTPException(404, "not a regular file")
                flags |= os.O_NONBLOCK

            child = os.open(name, flags, dir_fd=fd)
            os.close(fd)
            fd = child

        if not directory and not stat.S_ISREG(os.fstat(fd).st_mode):
            raise HTTPException(404, "not a regular file")
        return fd
    except BaseException:
        os.close(fd)
        raise


# ── endpoints ───────────────────────────────────────────────────────────────


def as_json(obj, status=200):
    """ASCII-escaped, so undecodable file names can't break a response."""
    return Response(json.dumps(obj), status, media_type="application/json")


def page(request):
    return HTMLResponse(PAGE.replace("__ROOT__", html.escape(ROOT.name)))


KINDS = {
    stat.S_IFDIR: "dir",
    stat.S_IFREG: "file",
    stat.S_IFLNK: "link",
    stat.S_IFIFO: "fifo",
    stat.S_IFSOCK: "socket",
    stat.S_IFCHR: "char",
    stat.S_IFBLK: "block",
}


def api_ls(request):
    parts = resolve(request.query_params.get("path", ""))
    entries, hidden_count = [], 0

    fd = open_real(parts, directory=True)
    try:
        with os.scandir(fd) as it:
            for entry in it:
                try:
                    st = entry.stat(follow_symlinks=False)
                    target = os.readlink(entry.name, dir_fd=fd) if entry.is_symlink() else ""
                except OSError:  # removed while listing
                    continue

                kind = KINDS.get(stat.S_IFMT(st.st_mode), "other")
                child = [*parts, entry.name]
                if ignored(child, is_dir=kind == "dir"):
                    hidden_count += 1
                    continue

                item = {
                    "name": entry.name,
                    "kind": kind,
                    "mode": stat.filemode(st.st_mode),
                    "size": st.st_size,
                    "mtime": int(st.st_mtime),
                }
                if kind == "link":
                    item |= link_info(child, target)
                elif kind in ("file", "dir"):
                    need = os.R_OK | os.X_OK if kind == "dir" else os.R_OK
                    if not os.access(entry.name, need, dir_fd=fd):
                        item["noread"] = True
                entries.append(item)
    finally:
        os.close(fd)

    entries.sort(
        key=lambda x: (x["kind"] != "dir" and x.get("link") != "dir", x["name"].casefold())
    )
    return as_json({"path": "/".join(parts), "entries": entries, "hidden": hidden_count})


def link_info(parts, target):
    """Followed only inside ROOT; an outside target is never named."""
    real = under_root(ROOT.joinpath(*parts))
    if real is None:
        return {"link": "outside"}
    if hidden(real):
        return {"link": "hidden"}

    try:
        st = ROOT.joinpath(*real).stat()
    except OSError:
        return {"link": "broken", "target": target}

    kind = KINDS.get(stat.S_IFMT(st.st_mode), "other")
    return {
        "link": kind if kind in ("file", "dir") else "other",
        "target": target,
        "real": "/".join(real),
        "size": st.st_size,
        "mtime": int(st.st_mtime),
    }


TEXT_LIMIT = 1 << 20

# What the browser renders itself; anything else is shown as text or downloaded.
PREVIEWABLE = """
    image/png image/jpeg image/gif image/webp image/avif image/bmp image/svg+xml
    image/x-icon image/vnd.microsoft.icon
    audio/mpeg audio/ogg audio/opus audio/wav audio/x-wav audio/vnd.wave audio/flac
    audio/aac audio/mp4 audio/webm
    video/mp4 video/webm video/ogg video/quicktime
    application/pdf
""".split()  # noqa: SIM905

# Not in Python 3.12's built-in table.
mimetypes.add_type("image/webp", ".webp")
mimetypes.add_type("audio/flac", ".flac")
mimetypes.add_type("audio/mp4", ".m4a")
mimetypes.add_type("audio/ogg", ".ogg")


def api_file(request):
    parts = resolve(request.query_params.get("path", ""))
    fd = open_real(parts)
    try:
        st = os.fstat(fd)
        mime = mimetypes.guess_type(parts[-1], strict=False)[0] or ""
        info = {
            "path": "/".join(parts),
            "name": parts[-1],
            "size": st.st_size,
            "mtime": int(st.st_mtime),
            "mode": stat.filemode(st.st_mode),
            "mime": mime,
        }
        if mime in PREVIEWABLE:
            kind = "pdf" if mime == "application/pdf" else mime.partition("/")[0]
            return as_json(info | {"kind": kind})
        if st.st_size == 0:
            return as_json(info | {"kind": "empty"})

        data = b""
        while len(data) < TEXT_LIMIT and (chunk := os.read(fd, TEXT_LIMIT - len(data))):
            data += chunk
    finally:
        os.close(fd)

    truncated = st.st_size > len(data)
    if b"\0" not in data:
        with contextlib.suppress(UnicodeDecodeError):
            # final=False holds back a character cut in half by TEXT_LIMIT instead of failing
            text = codecs.getincrementaldecoder("utf-8")().decode(data, final=not truncated)
            return as_json(info | {"kind": "text", "text": text, "truncated": truncated})
    return as_json(info | {"kind": "binary"})


def api_index(request):
    if "gzip" in request.headers.get("accept-encoding", ""):
        headers = {"Content-Encoding": "gzip", "Vary": "Accept-Encoding"}
        return Response(INDEX_GZIP, media_type="application/json", headers=headers)
    return Response(INDEX, media_type="application/json", headers={"Vary": "Accept-Encoding"})


RANGE = re.compile(r"bytes=(\d*)-(\d*)")
CHUNK = 1 << 16

# Served files: an SVG or HTML opened on its own runs no script in this origin.
RAW_CSP = "default-src 'none'; img-src 'self'; media-src 'self'; style-src 'unsafe-inline'; sandbox"


def raw(request):
    parts = resolve(request.query_params.get("path", ""))
    fd = open_real(parts)
    st = os.fstat(fd)
    os.close(fd)

    name, size = parts[-1], st.st_size
    mime = mimetypes.guess_type(name, strict=False)[0]
    inline = "dl" not in request.query_params and mime in PREVIEWABLE
    disposition = "inline" if inline else "attachment"
    headers = {
        "Accept-Ranges": "bytes",
        "Content-Disposition": f"{disposition}; filename*=UTF-8''{quote(name, safe='')}",
        "Content-Security-Policy": RAW_CSP,
    }
    if inline and mime == "application/pdf":  # browser PDF viewers refuse sandboxed documents
        headers["Content-Security-Policy"] = "frame-ancestors 'self'"
        headers["X-Frame-Options"] = "SAMEORIGIN"

    start, end, status = 0, size - 1, 200
    rng = RANGE.fullmatch(request.headers.get("range", "").strip())
    if rng and (rng[1] or rng[2]):
        if rng[1]:
            start, end = int(rng[1]), min(int(rng[2] or end), end)
        else:  # suffix range: the last N bytes
            start = max(0, size - int(rng[2]))
        if start > end:
            return Response(status_code=416, headers={"Content-Range": f"bytes */{size}"})
        status = 206
        headers["Content-Range"] = f"bytes {start}-{end}/{size}"
    headers["Content-Length"] = str(end - start + 1)

    def body():
        fd = open_real(parts)  # opened here, so a response that never streams holds no descriptor
        try:
            now = os.fstat(fd)
            if (now.st_dev, now.st_ino) != (st.st_dev, st.st_ino):
                return
            pos = start
            while pos <= end and (chunk := os.pread(fd, min(CHUNK, end - pos + 1), pos)):
                yield chunk
                pos += len(chunk)
        finally:
            os.close(fd)

    media_type = mime if inline else "application/octet-stream"
    return StreamingResponse(body(), status, headers, media_type=media_type)


async def on_error(request, exc):
    if isinstance(exc, HTTPException):
        return as_json({"error": exc.detail}, exc.status_code)
    if isinstance(exc, PermissionError):
        return as_json({"error": "permission denied"}, 403)
    return as_json({"error": "not found"}, 404)


# ── host check and headers ──────────────────────────────────────────────────

LAN_SUFFIXES = (".local", ".lan", ".home", ".internal", ".home.arpa", ".ts.net")


def host_allowed(host):
    """DNS-rebinding guard: a hostile page reaches us under its own domain name."""
    try:
        name = (urlsplit(f"//{host}").hostname or "").rstrip(".")
    except ValueError:  # e.g. an unclosed IPv6 bracket
        return False
    if not name:
        return False

    with contextlib.suppress(ValueError):
        return ipaddress.ip_address(name).is_loopback or not LOOPBACK
    if name == "localhost" or name.endswith(".localhost"):
        return True
    return not LOOPBACK and ("." not in name or name.endswith(LAN_SUFFIXES) or name in NAMES)


CSP = (
    "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; "
    "img-src 'self' data:; media-src 'self'; frame-src 'self'; "
    "base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
)

HEADERS = {
    "content-security-policy": CSP,
    "x-content-type-options": "nosniff",
    "x-frame-options": "DENY",
    "referrer-policy": "no-referrer",
    "cross-origin-opener-policy": "same-origin",
    "cross-origin-resource-policy": "same-origin",
    "cache-control": "no-store",
}


def guard(app):
    async def guarded(scope, receive, send):
        if scope["type"] != "http":
            await app(scope, receive, send)
            return

        host = next((v.decode("latin-1") for k, v in scope["headers"] if k == b"host"), "")
        if not host_allowed(host):
            await PlainTextResponse("host not allowed\n", 403)(scope, receive, send)
            return

        async def send_secured(message):
            if message["type"] == "http.response.start":
                headers = list(message.get("headers", []))
                present = {k.decode().lower() for k, _ in headers}
                missing = [(k, v) for k, v in HEADERS.items() if k not in present]
                message["headers"] = headers + [(k.encode(), v.encode()) for k, v in missing]
            await send(message)

        await app(scope, receive, send_secured)

    return guarded


app = guard(
    Starlette(
        routes=[
            Route("/", page),
            Route("/app.css", lambda request: Response(CSS, media_type="text/css")),
            Route("/app.js", lambda request: Response(JS, media_type="text/javascript")),
            Route("/api/ls", api_ls),
            Route("/api/file", api_file),
            Route("/api/index", api_index),
            Route("/raw", raw),
        ],
        exception_handlers={HTTPException: on_error, OSError: on_error},
    )
)


# ── main ────────────────────────────────────────────────────────────────────

INDEX_LIMIT = 200_000


def parse_bind(value):
    host, port = "127.0.0.1", "8000"
    if value.startswith("["):
        host, _, rest = value[1:].partition("]")
        port = rest.removeprefix(":") or port
    elif value.isdigit():
        port = value
    elif value.count(":") == 1:
        h, p = value.split(":")
        host, port = h or host, p or port
    elif value:
        host = value

    if not port.isdigit() or int(port) not in range(1, 65536):
        raise argparse.ArgumentTypeError(f"invalid port: {port}")
    return host, int(port)


def main():  # noqa: C901, PLR0915
    global ROOT, GITIGNORE, EXCLUDES, INDEX, INDEX_GZIP, LOOPBACK, NAMES  # noqa: PLW0603

    # bootstrap: parse arguments, refuse unsafe roots
    parser = argparse.ArgumentParser(
        prog="share",
        description="Share a directory read-only over HTTP; hides .gitignored and secret files.",
    )
    parser.add_argument(
        "bind",
        nargs="?",
        default="",
        type=parse_bind,
        metavar="[HOST][:PORT]",
        help="address to listen on (default 127.0.0.1:8000)",
    )
    parser.add_argument(
        "-C", "--cwd", default=".", metavar="PATH", help="directory to serve (default: current)"
    )
    parser.add_argument(
        "--no-ignore",
        action="store_true",
        help="also show .gitignored files and caches; secrets stay hidden",
    )
    args = parser.parse_args()
    host, port = args.bind

    ROOT = Path(args.cwd).resolve()
    GITIGNORE = not args.no_ignore
    if not ROOT.is_dir():
        parser.error(f"not a directory: {args.cwd}")
    if Path.home().resolve().is_relative_to(ROOT):
        parser.error(f"refusing to serve {ROOT}: it holds your home directory; pass a subdirectory")
    if any(SECRET_SPEC.match_file(p) for p in ROOT.parts):
        parser.error(f"refusing to serve {ROOT}: it is a protected directory")

    # prepare: ignore files from above ROOT, then the jump-to-file index
    EXCLUDES = []  # (path prefix, ignore file), strongest first
    prefix = ""
    repo = next((d for d in [ROOT, *ROOT.parents] if (d / ".git").exists()), None)
    if repo:
        for d in ROOT.parents:
            if not d.is_relative_to(repo):
                break
            EXCLUDES.append((f"{ROOT.relative_to(d)}/", d / ".gitignore"))
        prefix = f"{ROOT.relative_to(repo)}/" if repo != ROOT else ""
        EXCLUDES.append((prefix, repo / ".git" / "info" / "exclude"))
    EXCLUDES.append((prefix, Path.home() / ".config" / "git" / "ignore"))

    started = time.monotonic()
    files, truncated = [], False
    for top, dirs, names in ROOT.walk():  # symlinked directories are listed, not walked
        parts = list(top.relative_to(ROOT).parts)
        dirs[:] = sorted(d for d in dirs if not ignored([*parts, d], is_dir=True))
        visible = [n for n in sorted(names) if not ignored([*parts, n], is_dir=False)]
        files += ["/".join([*parts, n]) for n in visible]
        if len(files) >= INDEX_LIMIT:
            files, truncated = files[:INDEX_LIMIT], True
            break
    took = time.monotonic() - started

    INDEX = json.dumps({"files": files, "truncated": truncated}).encode()
    INDEX_GZIP = gzip.compress(INDEX, 6)

    # config: who may connect, and the server
    try:
        ip = ipaddress.ip_address(host)
    except ValueError:
        ip = None
    LOOPBACK = ip.is_loopback if ip else host == "localhost"
    NAMES = {socket.gethostname().lower(), socket.getfqdn().lower()}

    config = uvicorn.Config(app, host=host, port=port, server_header=False, proxy_headers=False)
    logging.getLogger("uvicorn.error").setLevel(logging.WARNING)  # after Config sets up logging

    server = uvicorn.Server(config)
    # Nothing is ever written, so there is nothing to shut down gracefully: stop at once, quietly.
    server.handle_exit = lambda sig, frame: os._exit(0)

    # run: print where to connect, then serve
    urls = [host]
    if ip and ip.is_unspecified:
        urls = [socket.gethostname()]
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s, contextlib.suppress(OSError):
            s.connect(("192.0.2.1", 9))  # UDP connect sends nothing; it picks the outgoing address
            urls.append(s.getsockname()[0])
    urls = [f"[{url}]" if ":" in url else url for url in urls]

    limit = " (limit reached)" if truncated else ""
    gitignore = "applied" if GITIGNORE else "not applied"
    print(f"share: {ROOT} (read-only)")
    print(f"  {len(files)} files indexed{limit} in {took:.1f}s, .gitignore {gitignore}")
    for url in urls:
        print(f"  http://{url}:{port}/")
    if not LOOPBACK:
        print("  reachable from other machines: anyone who can connect can read what is listed")

    server.run()


# ── page ────────────────────────────────────────────────────────────────────

PAGE = """<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#F3F0E8">
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0C1030">
<title>__ROOT__ — share</title>
<link rel="icon" href="data:,">
<link rel="stylesheet" href="/app.css">
<script src="/app.js" defer></script>
</head>
<body data-root="__ROOT__">

<header id="bar">
  <button id="tree-btn" title="toggle tree (b)" aria-label="toggle tree">☰</button>
  <nav id="crumbs" aria-label="path"></nav>
  <button id="find-btn" title="jump to file (t)">find</button>
