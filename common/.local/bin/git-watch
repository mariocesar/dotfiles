#!/bin/sh
# git watch [-u] [<git diff args>]: live `git diff` you can scroll, rendered by
# delta. Every other argument reaches `git diff` untouched.
set -eu

setup=

case "${1-}" in
    -u | --untracked)
        shift
        # git diff never sees untracked files. Intent-to-add them in a scratch
        # copy of the index -- the real one is untouched -- so they show up as
        # new files under whatever diff args were given, instead of needing a
        # second command whose output can't be combined.
        GIT_INDEX_FILE=$(mktemp "${TMPDIR:-/tmp}/git-watch-index.XXXXXX")
        export GIT_INDEX_FILE
        trap 'rm -f "$GIT_INDEX_FILE"' EXIT INT TERM
        # --git-path index would answer $GIT_INDEX_FILE, i.e. the copy itself.
        # A repo with no commits has no index yet; git then makes one from scratch.
        setup='cp "$(git rev-parse --git-dir)/index" "$GIT_INDEX_FILE" 2>/dev/null ||
                   rm -f "$GIT_INDEX_FILE"
               git add -N -- :/
              '
        ;;
esac

# -x keeps "$@" quoted; without it viddy joins the words into one sh -c string.
# delta sizes to 80 columns on a pipe; viddy exports COLUMNS to the child.
viddy \
    -n 1 \
    -x sh \
    -c "$setup"'git diff "$@" | delta -w "$COLUMNS"' _ "$@"
