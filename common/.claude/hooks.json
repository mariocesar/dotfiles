{
  "Notification": [
    {
      "matcher": "permission_prompt|idle_prompt|elicitation_dialog",
      "hooks": [
        {
          "type": "command",
          "command": "~/.claude/hooks/notify.sh",
          "timeout": 5
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "python3 ~/.claude/hooks/idle-reminder.py",
          "timeout": 5
        }
      ]
    }
  ]
}
