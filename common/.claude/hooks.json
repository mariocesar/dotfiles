{
  "Notification": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "~/.claude/hooks/notify.sh",
          "timeout": 5
        }
      ]
    }
  ],
  "SessionStart": [
    {
      "matcher": "startup|resume|clear",
      "hooks": [
        {
          "type": "command",
          "command": "~/.claude/hooks/notify.sh",
          "timeout": 5
        }
      ]
    },
    {
      "hooks": [
        {
          "type": "command",
          "command": "~/.claude/hooks/direnv-env.sh",
          "timeout": 10
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "python3 ~/.claude/hooks/idle-reminder.py",
          "timeout": 5
        },
        {
          "type": "command",
          "command": "~/.claude/hooks/notify.sh",
          "timeout": 5
        }
      ]
    }
  ],
  "CwdChanged": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "~/.claude/hooks/direnv-env.sh",
          "timeout": 10
        }
      ]
    }
  ],
  "FileChanged": [
    {
      "matcher": ".envrc|.env",
      "hooks": [
        {
          "type": "command",
          "command": "~/.claude/hooks/direnv-env.sh",
          "timeout": 10
        }
      ]
    }
  ]
}
