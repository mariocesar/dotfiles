[Desktop Entry]
Type=Application
Name=Neovim (Ghostty)
Icon=nvim
# Stock nvim.desktop is Terminal=true, which makes xdg-open guess a terminal —
# unreliable under niri. Spawn Ghostty explicitly instead.
Exec=ghostty -e nvim %F
Terminal=false
# A MIME handler, not an app — keep it out of launchers.
NoDisplay=true
Categories=Utility;TextEditor;
MimeType=text/english;text/plain;text/x-makefile;text/x-c++hdr;text/x-c++src;text/x-chdr;text/x-csrc;text/x-java;text/x-moc;text/x-pascal;text/x-tcl;text/x-tex;application/x-shellscript;text/x-c;text/x-c++;
