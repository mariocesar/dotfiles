#!/usr/bin/env bash

set -euo pipefail

# Asserts the DMS settings chosen in the dotfiles through its IPC, counterpart
# to macos/.local/bin/update-preferences and `defaults write`. DMS owns
# settings.json; only the keys listed here are pinned, the rest stay UI-managed.

usage() {
    cat <<'USAGE'
update-preferences - apply the DMS settings chosen in the dotfiles

Usage: update-preferences [-n] [-h]

  -n  list what differs, change nothing
USAGE
}

dry=0
while getopts ':nh' opt; do
    case "$opt" in
        n) dry=1 ;;
        h) usage; exit 0 ;;
        *) usage >&2; exit 2 ;;
    esac
done

command -v dms >/dev/null 2>&1 || { echo "update-preferences: needs dms" >&2; exit 1; }
# dms ipc exits 0 whether or not the shell is up; only the reply tells.
# The -- keeps negative values like -100 from being read as flags.
[[ $(dms ipc call -- settings get settingsConfigVersion) =~ ^[0-9]+$ ]] || {
    echo "update-preferences: DMS is not running" >&2
    exit 1
}

# Every line is the command that enforces a setting, tagged with what happened to it.
checked=0
changed=0
show() {
    local tag=$1 note=$2
    shift 2
    printf '%-6s' "$tag"
    printf ' %q' "$@"
    if [ -n "$note" ]; then
        printf '  # %s' "$note"
    fi
    printf '\n'
}

# Only booleans, numbers and strings can be set this way; DMS rejects lists.
dms_pref() {
    local key=$1 want=$2 have reply
    local -a cmd=(dms ipc call -- settings set "$key" "$want")
    checked=$((checked + 1))
    have=$(dms ipc call -- settings get "$key")
    if [ "$have" = undefined ]; then
        echo "update-preferences: $key: unknown setting" >&2
        exit 1
    fi
    # get replies in JSON, so strings come back quoted.
    have=${have#\"}
    have=${have%\"}
    if [ "$have" = "$want" ]; then
        show ok "" "${cmd[@]}"
        return 0
    fi
    changed=$((changed + 1))
    if [ "$dry" -eq 1 ]; then
        show drift "is $have" "${cmd[@]}"
        return 0
    fi
    reply=$("${cmd[@]}")
    [ "$reply" = SETTINGS_SET_SUCCESS ] || { echo "update-preferences: $key: $reply" >&2; exit 1; }
    show set "was $have" "${cmd[@]}"
}

# Monitors off 5 min after locking; seconds.
dms_pref acPostLockMonitorTimeout 300

# Appearance
dms_pref currentThemeName blue
dms_pref widgetBackgroundColor sth
dms_pref cornerRadius 12
dms_pref textRenderType 1
dms_pref animationSpeed 2
dms_pref animationVariant 2
dms_pref motionEffect 2
dms_pref blurBorderEnabled false
dms_pref barElevationEnabled false

# Bar and window frame
dms_pref frameBarSize 26
dms_pref frameBarInsetPadding 7
dms_pref frameThickness 7
dms_pref frameRounding 10
dms_pref frameShowOnOverview true

# Dock
dms_pref showDock true
dms_pref dockPosition 2
dms_pref dockIconSize 24
dms_pref dockMargin 5
dms_pref dockBottomGap -100
dms_pref dockOpenOnOverview true
dms_pref dockUseOverlayLayer true
dms_pref dockShowTrash true
dms_pref dockTrashFileManager nautilus
dms_pref appsDockColorizeActive true
dms_pref appsDockHideIndicators true
dms_pref runningAppsCurrentWorkspace false

# Launcher
dms_pref appLauncherViewMode grid
dms_pref launcherUseOverlayLayer true
dms_pref spotlightBarShowModeChips true

# niri layout overrides
dms_pref niriLayoutBorderSize 1
dms_pref niriLayoutGapsOverride 4
dms_pref niriLayoutRadiusOverride 6

# Misc
dms_pref clockFormat 24h
dms_pref weatherEnabled false
dms_pref useSystemSoundTheme true
dms_pref osdPowerProfileEnabled true
dms_pref maxFprintTries 3

if [ "$dry" -eq 1 ]; then
    echo "$checked settings, $changed would change"
else
    echo "$checked settings, $changed changed"
fi
