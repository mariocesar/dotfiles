#!/usr/bin/env bash
# Upgrade repo and AUR packages with paru, then remove orphans.

set -euo pipefail

echo "⇨ Upgrading repos and AUR"

paru -Syu --skipreview


echo "⇨ Removing orphans"

orphans=$(pacman -Qtdq || true)
if [[ -n "$orphans" ]]; then
    sudo pacman -Rns $orphans;
else
    echo "No orphans found."
fi
