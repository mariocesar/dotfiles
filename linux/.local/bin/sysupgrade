#!/usr/bin/env bash
# Upgrade repo and AUR packages with paru, remove orphans, then prune package caches.

set -euo pipefail

echo "⇨ Upgrading repos and AUR"

paru -Syu --skipreview


echo "⇨ Removing orphans"

orphans=$(pacman -Qtdq || true)
if [[ -n "$orphans" ]]; then
    sudo pacman -Rns $orphans;
else
    echo "No orphans found."
fi


echo "⇨ Pruning package caches"

sudo paccache -rk2
sudo paccache -ruk0
# AUR clones keep every downloaded source and built package; all of it is rebuildable from the PKGBUILD
for dir in ~/.cache/paru/clone/*/; do
    git -C "$dir" clean -fdxq
done
