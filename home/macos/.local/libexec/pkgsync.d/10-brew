#!/usr/bin/env bash
# Homebrew: install what the Brewfile names, report what it doesn't.
# -n prints +name for missing and -name for not in the Brewfile, one per line.
set -euo pipefail

has brew || { echo "pkgsync: needs brew" >&2; exit 1; }

brewfile="${XDG_CONFIG_HOME:-$HOME/.config}/homebrew/Brewfile"
[ -f "$brewfile" ] || { echo "pkgsync: no Brewfile at $brewfile" >&2; exit 1; }

# Compare bare names; the Brewfile and brew may disagree on tap-qualifying them.
names() { sed 's|.*/||' | sort -u; }

# The Brewfile may name an alias (gpg is gnupg); falls back to the names as written when a tap is still missing.
canonical() {
    local kind=$1; shift
    [ $# -gt 0 ] || return 0
    brew info --json=v2 "$kind" "$@" 2>/dev/null | jq -r '.formulae[].name, .casks[].token' || printf '%s\n' "$@"
}

listed=$( {
    canonical --formula $(brew bundle list --formula --file="$brewfile")
    canonical --cask $(brew bundle list --cask --file="$brewfile")
} | names)
missing=$(comm -23 <(printf '%s\n' "$listed") <( { brew list --formula -1; brew list --cask -1; } | names))
unlisted=$(comm -23 <( { brew leaves --installed-on-request; brew list --cask -1; } | names) <(printf '%s\n' "$listed"))

if [ "$DRY" -eq 1 ]; then
    printf '%s\n' $missing | sed -n 's/^./+&/p'
    printf '%s\n' $unlisted | sed -n 's/^./-&/p'
    exit 0
fi

step "Installing missing packages"
# Upgrading is sysupgrade's job.
brew bundle install --no-upgrade --file="$brewfile"

if [ -n "$unlisted" ]; then
    step "Installed but not in the Brewfile"
    printf '%s\n' $unlisted | sed -n 's/^./-&/p'
fi
