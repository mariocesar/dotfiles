#!/usr/bin/env bash
# Arch: install what pkglist.txt and pkglist-aur.txt name, report explicit packages on neither.
# -n prints +pkg for missing and -pkg for not on any list, one per line.
set -euo pipefail

is_distro arch || exit 0

config="${XDG_CONFIG_HOME:-$HOME/.config}/pkgsync"

# The lists are hand-written: strip comments and blanks.
read_list() {
    [ -f "$1" ] || return 0
    sed -e 's/#.*//' -e 's/[[:space:]]//g' -e '/^$/d' "$1"
}

missing() {
    read_list "$1" | while IFS= read -r pkg; do
        pacman -Qq -- "$pkg" >/dev/null 2>&1 || printf '%s\n' "$pkg"
    done
}

native=$(missing "$config/pkglist.txt")
aur=$(missing "$config/pkglist-aur.txt")
unlisted=$(comm -23 <(pacman -Qqe | sort) <({ read_list "$config/pkglist.txt"; read_list "$config/pkglist-aur.txt"; } | sort -u))

if [ "$DRY" -eq 1 ]; then
    printf '%s\n' $native $aur | sed -n 's/^./+&/p'
    printf '%s\n' $unlisted | sed -n 's/^./-&/p'
    exit 0
fi

step "Installing missing packages"
# No -y: a database refresh without -u is a partial upgrade. A 404 means run sysupgrade first.
[ -z "$native" ] || sudo pacman -S --needed -- $native
[ -z "$aur" ] || yay -S --needed --answerdiff None --answerclean None -- $aur

if [ -n "$unlisted" ]; then
    step "Installed explicitly but on no list"
    printf '%s\n' $unlisted | sed -n 's/^./-&/p'
fi
