[Desktop Entry]
Type=Application
Name=Claude
Comment=Claude in a Chrome app window
Icon=claude
# ~/.local/bin is only on PATH for interactive shells, not the niri session.
Exec=sh -c "exec \\$HOME/.local/bin/webapp https://claude.ai"
Terminal=false
# Chrome ignores --class on Wayland; from: webapp --app-id https://claude.ai
StartupWMClass=chrome-claude.ai__-Default
Categories=Network;Chat;
Keywords=ai;chat;anthropic;
