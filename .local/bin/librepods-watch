#!/usr/bin/env bash
# Run LibrePods only while the AirPods are connected. Whenever they are not it
# keeps a bluez discovery scan open, and a bonded BLE mouse can't re-attach
# through one (see bt-mouse-guard).
set -euo pipefail

GRACE=${LIBREPODS_GRACE:-15}   # seconds; covers `airpods reconnect`

find_airpods() {
    [ -z "${AIRPODS_MAC:-}" ] || { echo "$AIRPODS_MAC"; return; }
    bluetoothctl devices 2>/dev/null | awk 'tolower($0) ~ /airpods/ {print $2; exit}'
}

connected() { bluetoothctl info "$MAC" 2>/dev/null | grep -q 'Connected: yes'; }
running() { pgrep -x librepods >/dev/null; }

start() {
    running && return 0
    echo "AirPods connected, starting librepods"
    # Spawn from niri so it gets the session env and outlives this service.
    niri msg action spawn -- librepods >/dev/null 2>&1 \
        || setsid -f librepods >/dev/null 2>&1 \
        || echo "could not start librepods"
}

stop() {
    running || return 0
    echo "AirPods disconnected, stopping librepods"
    pkill -x librepods || true
}

until MAC=$(find_airpods) && [ -n "$MAC" ]; do sleep 60; done
path=$(busctl --system tree org.bluez 2>/dev/null | grep -o "/org/bluez/hci[0-9]*/dev_${MAC//:/_}$" | head -1 || true)
path=${path:-/org/bluez/hci0/dev_${MAC//:/_}}

if connected; then start; else stop; fi

gdbus monitor --system --dest org.bluez --object-path "$path" |
while read -r line; do
    case "$line" in
        *"'Connected': <true>"*) start ;;
        *"'Connected': <false>"*)
            sleep "$GRACE"
            connected || stop ;;
    esac
done
