# ~/.config/ghostty/config
# macOS · tuned for long agent sessions (Claude Code, Codex, etc.)

# ── Font ─────────────────────────────────────────────────────────────
font-family = "FiraCode Nerd Font Mono"
font-size = 10
font-thicken = true

# Ligatures are nice in an editor, confusing in agent diff output.
# Uncomment to disable:
font-feature = -calt
font-feature = -liga

# Slightly looser lines make long log/diff dumps easier to scan.
adjust-cell-height = 8%

# ── Window ───────────────────────────────────────────────────────────
window-decoration = true
macos-titlebar-style = transparent
macos-non-native-fullscreen = false
window-padding-x = 12
window-padding-y = 12
window-padding-balance = true
window-save-state = always
resize-overlay = never

# 0.90 + heavy blur looks great and hurts when you're reading a diff
# at 11pm. 0.96 keeps the effect without eating contrast.
background-opacity = 0.96
background-blur = true
minimum-contrast = 1.1
alpha-blending = linear-corrected

# ── macOS keyboard ───────────────────────────────────────────────────
# Without this, Option produces ø/å instead of Alt — breaks alt+f,
# alt+b, alt+. and most shell/TUI word-motion bindings.
macos-option-as-alt = left

# ── Cursor ───────────────────────────────────────────────────────────
cursor-style = block
cursor-style-blink = true

# ── Scrollback ───────────────────────────────────────────────────────
# NOTE: this is BYTES, not lines. Default is 10 MB. 100 MB holds a
# full day of agent output; bump down if you keep 15 splits open.
scrollback-limit = 100000000

# ── Behaviour ────────────────────────────────────────────────────────
mouse-hide-while-typing = true
copy-on-select = false
# `always`, not `true`: cmd+w should confirm on an idle tab too.
confirm-close-surface = always
app-notifications = no-clipboard-copy,no-config-reload

# Splits
unfocused-split-opacity = 0.8
unfocused-split-fill = #000000

# ── Shell integration ────────────────────────────────────────────────
shell-integration = detect
shell-integration-features = cursor,sudo,title

# ── Keybindings ──────────────────────────────────────────────────────
# macOS defaults already cover cmd+t / cmd+n / cmd+d / cmd+shift+d /
# cmd+plus / cmd+minus / cmd+0. Don't shadow ctrl+* — TUIs need it.

# Multiline input in Claude Code and friends.
keybind = shift+enter=text:\n

# Handy for agent work: clear the scrollback without clearing state.
keybind = cmd+k=clear_screen

# ── Theme ────────────────────────────────────────────────────────────
# `ghostty +list-themes` to browse. Auto-switch example:
# theme = dark:catppuccin-mocha,light:catppuccin-latte
theme = Adwaita Dark

# Loaded last so it wins over anything above.
config-file = ?autho/theme.ghostty
