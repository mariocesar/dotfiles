#!/usr/bin/env bash
# Upgrade Homebrew formulae and casks, then remove stale versions and cached downloads.

set -euo pipefail

echo "⇨ Refreshing formulae"

brew update

echo "⇨ Upgrading formulae and casks"

# Casks that update themselves are left alone; --greedy would fight them.
brew upgrade

echo "⇨ Removing stale versions and cached downloads"

brew cleanup --prune=all
