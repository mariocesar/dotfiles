{
    "global": { "show_in_menu_bar": false },
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Panic Nova: Allow Home and End to navigate along a line.",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "type": "frontmost_application_unless",
                                        "bundle_identifiers": [
                                            "^com\\.apple\\.Terminal$",
                                            "^com\\.mitchellh\\.ghostty$",
                                            "^com\\.github\\.wez\\.wezterm$"
                                        ]
                                    }
                                ],
                                "from": {
                                    "key_code": "home",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    {
                                        "key_code": "left_arrow",
                                        "modifiers": "command"
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    {
                                        "type": "frontmost_application_unless",
                                        "bundle_identifiers": [
                                            "^com\\.apple\\.Terminal$",
                                            "^com\\.mitchellh\\.ghostty$",
                                            "^com\\.github\\.wez\\.wezterm$"
                                        ]
                                    }
                                ],
                                "from": {
                                    "key_code": "end",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    {
                                        "key_code": "right_arrow",
                                        "modifiers": "command"
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Change caps_lock to Command if pressed with other keys, to escape if pressed alone.",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "key_code": "left_command" }],
                                "to_if_alone": [{ "key_code": "escape" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "cmd+return opens a new Ghostty window, except in apps that use it to send or submit.",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "type": "frontmost_application_unless",
                                        "bundle_identifiers": [
                                            "^com\\.tinyspeck\\.slackmacgap$",
                                            "^com\\.hnc\\.Discord$",
                                            "^com\\.apple\\.MobileSMS$",
                                            "^com\\.apple\\.mail$",
                                            "^com\\.anthropic\\.claudefordesktop$",
                                            "^com\\.openai\\.",
                                            "^us\\.zoom\\.xos$",
                                            "^com\\.apple\\.Safari$",
                                            "^com\\.google\\.Chrome$",
                                            "^company\\.thebrowser\\.Browser$",
                                            "^org\\.mozilla\\.",
                                            "^com\\.microsoft\\.VSCode$",
                                            "^com\\.apple\\.dt\\.Xcode$",
                                            "^md\\.obsidian$"
                                        ]
                                    }
                                ],
                                "from": {
                                    "key_code": "return_or_enter",
                                    "modifiers": { "mandatory": ["command"] }
                                },
                                "to": [{ "shell_command": "osascript -e 'tell application \"Ghostty\"' -e 'new window' -e 'activate' -e 'end tell'" }],
                                "type": "basic"
                            }
                        ]
                    }
                ]
